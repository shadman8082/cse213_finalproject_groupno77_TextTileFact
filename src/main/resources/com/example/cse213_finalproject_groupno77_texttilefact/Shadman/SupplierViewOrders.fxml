<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.cse213_finalproject_groupno77_texttilefact.Shadman.SupplierViewOrdersController">
    <children>
        <Label layoutX="280.0" layoutY="20.0" text="Purchase Orders" style="-fx-font-size: 20px; -fx-font-weight: bold;" />

        <HBox layoutX="50.0" layoutY="60.0" spacing="10">
            <children>
                <TextField fx:id="txtSearch" prefWidth="200" promptText="Search orders..." />
                <ComboBox fx:id="cmbStatus" promptText="Filter by Status" prefWidth="150" />
                <Button fx:id="btnSearch" onAction="#handleSearch" text="Search" />
                <Button fx:id="btnRefresh" onAction="#handleRefresh" text="Refresh" />
            </children>
        </HBox>

        <TableView fx:id="orderTable" layoutX="50.0" layoutY="110.0" prefHeight="350" prefWidth="700">
            <columns>
                <TableColumn fx:id="colOrderId" prefWidth="80" text="Order ID" />
                <TableColumn fx:id="colMaterialName" prefWidth="150" text="Material Name" />
                <TableColumn fx:id="colQuantity" prefWidth="80" text="Quantity" />
                <TableColumn fx:id="colPrice" prefWidth="100" text="Price (BDT)" />
                <TableColumn fx:id="colRequiredDate" prefWidth="100" text="Required Date" />
                <TableColumn fx:id="colStatus" prefWidth="100" text="Status" />
                <TableColumn fx:id="colActions" prefWidth="90" text="Actions" />
            </columns>
        </TableView>

        <VBox layoutX="50.0" layoutY="480.0" spacing="10">
            <Label fx:id="lblSelectedOrder" text="Selected Order: None" />
            <HBox spacing="10">
                <Button fx:id="btnViewDetails" onAction="#handleViewDetails" text="View Details" />
                <Button fx:id="btnConfirmOrder" onAction="#handleConfirmOrder" text="Confirm Order" style="-fx-background-color: #27ae60; -fx-text-fill: white;" />
                <Button fx:id="btnBack" onAction="#handleBack" text="Back to Dashboard" />
            </HBox>
        </VBox>

        <Label fx:id="lblStatus" layoutX="50.0" layoutY="550.0" prefWidth="700" />
    </children>
</AnchorPane>
