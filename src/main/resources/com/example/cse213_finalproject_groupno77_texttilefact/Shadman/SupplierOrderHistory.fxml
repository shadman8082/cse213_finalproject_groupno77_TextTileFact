<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="500" prefWidth="700" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.cse213_finalproject_groupno77_texttilefact.Shadman.SupplierOrderHistoryController">

    <Label layoutX="250" layoutY="20" style="-fx-font-size: 18px;" text="Order History" />

    <HBox layoutX="50" layoutY="60" spacing="10">
        <TextField fx:id="searchField" prefWidth="200" promptText="Search orders..." />
        <Button fx:id="searchButton" onAction="#handleSearch" text="Search" />
    </HBox>

    <TableView fx:id="orderTable" layoutX="50" layoutY="110" prefHeight="300" prefWidth="600">
        <columns>
            <TableColumn fx:id="orderIdCol" prefWidth="80" text="Order ID" />
            <TableColumn fx:id="dateCol" prefWidth="100" text="Date" />
            <TableColumn fx:id="materialCol" prefWidth="150" text="Material" />
            <TableColumn fx:id="quantityCol" prefWidth="80" text="Qty" />
            <TableColumn fx:id="statusCol" prefWidth="100" text="Status" />
            <TableColumn fx:id="amountCol" prefWidth="100" text="Amount" />
        </columns>
    </TableView>

    <VBox layoutX="50" layoutY="420" spacing="10">
        <Button fx:id="viewButton" onAction="#handleViewDetails" text="View Details" prefWidth="150" />
        <Button fx:id="backButton" onAction="#handleBack" text="Back" prefWidth="150" />
        <Label fx:id="statusLabel" />
    </VBox>

</AnchorPane>
