<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.cse213_finalproject_groupno77_texttilefact.Shadman.SupplierDispatchMaterialsController">
    <children>
        <Label layoutX="280.0" layoutY="20.0" text="Dispatch Raw Materials" style="-fx-font-size: 20px; -fx-font-weight: bold;" />

        <TableView fx:id="dispatchTable" layoutX="50.0" layoutY="60.0" prefHeight="250" prefWidth="700">
            <columns>
                <TableColumn fx:id="colDispatchId" prefWidth="80" text="Order ID" />
                <TableColumn fx:id="colDispatchMaterial" prefWidth="150" text="Material" />
                <TableColumn fx:id="colDispatchQuantity" prefWidth="80" text="Quantity" />
                <TableColumn fx:id="colDispatchDate" prefWidth="100" text="Due Date" />
                <TableColumn fx:id="colDispatchStatus" prefWidth="100" text="Status" />
                <TableColumn fx:id="colDispatchAction" prefWidth="120" text="Action" />
            </columns>
        </TableView>

        <Label layoutX="50.0" layoutY="330.0" text="Dispatch Details" style="-fx-font-weight: bold;" />

        <GridPane layoutX="50.0" layoutY="360.0" hgap="10" vgap="10" prefWidth="700">
            <columnConstraints>
                <ColumnConstraints prefWidth="150" />
                <ColumnConstraints prefWidth="250" />
                <ColumnConstraints prefWidth="150" />
                <ColumnConstraints prefWidth="250" />
            </columnConstraints>
            <rowConstraints>
                <RowConstraints prefHeight="30" />
                <RowConstraints prefHeight="30" />
                <RowConstraints prefHeight="30" />
            </rowConstraints>

            <children>
                <Label text="Order ID:" GridPane.rowIndex="0" GridPane.columnIndex="0" />
                <TextField fx:id="txtDispOrderId" editable="false" GridPane.rowIndex="0" GridPane.columnIndex="1" />

                <Label text="Delivery Vehicle:" GridPane.rowIndex="0" GridPane.columnIndex="2" />
                <ComboBox fx:id="cmbVehicle" GridPane.rowIndex="0" GridPane.columnIndex="3" />

                <Label text="Driver:" GridPane.rowIndex="1" GridPane.columnIndex="0" />
                <ComboBox fx:id="cmbDriver" GridPane.rowIndex="1" GridPane.columnIndex="1" />

                <Label text="Dispatch Date:" GridPane.rowIndex="1" GridPane.columnIndex="2" />
                <DatePicker fx:id="dpDispatchDate" GridPane.rowIndex="1" GridPane.columnIndex="3" />

                <Label text="Tracking Number:" GridPane.rowIndex="2" GridPane.columnIndex="0" />
                <TextField fx:id="txtTrackingNumber" GridPane.rowIndex="2" GridPane.columnIndex="1" />
            </children>
        </GridPane>

        <VBox layoutX="50.0" layoutY="470.0" spacing="15">
            <HBox spacing="10">
                <Button fx:id="btnMarkDispatched" onAction="#handleMarkDispatched" text="Mark as Dispatched" style="-fx-background-color: #27ae60; -fx-text-fill: white;" prefWidth="180" />
                <Button fx:id="btnSaveDispatch" onAction="#handleSaveDispatch" text="Save Dispatch Info" prefWidth="180" />
                <Button fx:id="btnBack" onAction="#handleBack" text="Back" prefWidth="180" />
            </HBox>
            <Label fx:id="lblDispatchStatus" />
        </VBox>
    </children>
</AnchorPane>
