<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="500.0" prefWidth="700.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.cse213_finalproject_groupno77_texttilefact.Shadman.SupplierMarkDeliveryController">
    <children>
        <Label layoutX="250.0" layoutY="20.0" text="Mark Delivery as Complete" style="-fx-font-size: 20px; -fx-font-weight: bold;" />

        <HBox layoutX="50.0" layoutY="60.0" spacing="10">
            <TextField fx:id="txtSearchDelivery" prefWidth="200" promptText="Search by Order ID or Tracking No." />
            <Button fx:id="btnSearchDelivery" onAction="#handleSearch" text="Search" />
        </HBox>

        <TableView fx:id="deliveryTable" layoutX="50.0" layoutY="110.0" prefHeight="250" prefWidth="600">
            <columns>
                <TableColumn fx:id="colDelOrderId" prefWidth="80" text="Order ID" />
                <TableColumn fx:id="colDelTracking" prefWidth="120" text="Tracking No" />
                <TableColumn fx:id="colDelMaterial" prefWidth="150" text="Material" />
                <TableColumn fx:id="colDelStatus" prefWidth="100" text="Status" />
                <TableColumn fx:id="colDelDate" prefWidth="100" text="Dispatch Date" />
                <TableColumn fx:id="colDelAction" prefWidth="50" text="" />
            </columns>
        </TableView>

        <VBox layoutX="50.0" layoutY="380.0" spacing="15">
            <HBox spacing="10">
                <Label text="Selected Order:" />
                <Label fx:id="lblSelectedOrder" text="None" style="-fx-font-weight: bold;" />
            </HBox>

            <HBox spacing="10">
                <Button fx:id="btnMarkDelivered" onAction="#handleMarkDelivered" text="Mark as Delivered" style="-fx-background-color: #27ae60; -fx-text-fill: white;" prefWidth="180" />
                <Button fx:id="btnViewDetails" onAction="#handleViewDetails" text="View Details" prefWidth="180" />
                <Button fx:id="btnBack" onAction="#handleBack" text="Back" prefWidth="180" />
            </HBox>

            <Label fx:id="lblDeliveryStatus" />
        </VBox>
    </children>
</AnchorPane>
