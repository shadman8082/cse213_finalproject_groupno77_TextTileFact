<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="550.0" prefWidth="750.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.cse213_finalproject_groupno77_texttilefact.Shadman.SupplierUploadInvoiceController">
    <children>
        <Label layoutX="280.0" layoutY="20.0" text="Upload Invoice/Bill" style="-fx-font-size: 20px; -fx-font-weight: bold;" />

        <TableView fx:id="invoiceTable" layoutX="50.0" layoutY="60.0" prefHeight="200" prefWidth="650">
            <columns>
                <TableColumn fx:id="colInvOrderId" prefWidth="80" text="Order ID" />
                <TableColumn fx:id="colInvMaterial" prefWidth="150" text="Material" />
                <TableColumn fx:id="colInvAmount" prefWidth="100" text="Amount (BDT)" />
                <TableColumn fx:id="colInvStatus" prefWidth="100" text="Invoice Status" />
                <TableColumn fx:id="colInvSelect" prefWidth="80" text="Select" />
            </columns>
        </TableView>

        <Label layoutX="50.0" layoutY="280.0" text="Invoice Details" style="-fx-font-weight: bold;" />

        <GridPane layoutX="50.0" layoutY="310.0" hgap="10" vgap="10" prefWidth="650">
            <columnConstraints>
                <ColumnConstraints prefWidth="150" />
                <ColumnConstraints prefWidth="250" />
                <ColumnConstraints prefWidth="150" />
                <ColumnConstraints prefWidth="100" />
            </columnConstraints>
            <rowConstraints>
                <RowConstraints prefHeight="30" />
                <RowConstraints prefHeight="30" />
                <RowConstraints prefHeight="30" />
                <RowConstraints prefHeight="80" />
            </rowConstraints>

            <children>
                <Label text="Order ID:" GridPane.rowIndex="0" GridPane.columnIndex="0" />
                <TextField fx:id="txtInvOrderId" editable="false" GridPane.rowIndex="0" GridPane.columnIndex="1" />

                <Label text="Invoice Number:" GridPane.rowIndex="0" GridPane.columnIndex="2" />
                <TextField fx:id="txtInvoiceNumber" GridPane.rowIndex="0" GridPane.columnIndex="3" />

                <Label text="Total Amount:" GridPane.rowIndex="1" GridPane.columnIndex="0" />
                <TextField fx:id="txtAmount" GridPane.rowIndex="1" GridPane.columnIndex="1" />

                <Label text="Tax Amount:" GridPane.rowIndex="1" GridPane.columnIndex="2" />
                <TextField fx:id="txtTax" GridPane.rowIndex="1" GridPane.columnIndex="3" />

                <Label text="Invoice Date:" GridPane.rowIndex="2" GridPane.columnIndex="0" />
                <TextField fx:id="txtInvoiceDate" GridPane.rowIndex="2" GridPane.columnIndex="1" />

                <Label text="Upload File:" GridPane.rowIndex="2" GridPane.columnIndex="2" />
                <Button fx:id="btnBrowse" onAction="#handleBrowse" text="Browse PDF" GridPane.rowIndex="2" GridPane.columnIndex="3" />

                <Label text="Notes:" GridPane.rowIndex="3" GridPane.columnIndex="0" />
                <TextField fx:id="txtInvoiceNotes" GridPane.rowIndex="3" GridPane.columnIndex="1" GridPane.columnSpan="3" />
            </children>
        </GridPane>

        <VBox layoutX="50.0" layoutY="470.0" spacing="15">
            <HBox spacing="10">
                <Button fx:id="btnUploadInvoice" onAction="#handleUpload" text="Upload Invoice" style="-fx-background-color: #27ae60; -fx-text-fill: white;" prefWidth="180" />
                <Button fx:id="btnClear" onAction="#handleClear" text="Clear" prefWidth="180" />
                <Button fx:id="btnBack" onAction="#handleBack" text="Back" prefWidth="180" />
            </HBox>
            <Label fx:id="lblFileStatus" />
            <Label fx:id="lblUploadStatus" />
        </VBox>
    </children>
</AnchorPane>
