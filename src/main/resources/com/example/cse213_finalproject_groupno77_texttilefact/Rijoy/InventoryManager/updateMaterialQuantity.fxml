<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.cse213_finalproject_groupno77_texttilefactory.InventoryManager.updateMaterialQuantityController">

    <children>

        <Label layoutX="170" layoutY="20" style="-fx-font-size: 22px; -fx-font-weight: bold;" text="Update Material Quantity" />

        <Label layoutX="70" layoutY="110" style="-fx-font-size: 16px;" text="Material Name:" />

        <TextField fx:id="materialNameField" layoutX="220" layoutY="105" prefWidth="260" />

        <Label layoutX="70" layoutY="165" style="-fx-font-size: 16px;" text="New Quantity:" />

        <TextField fx:id="newQuantityField" layoutX="220" layoutY="160" prefWidth="260" />

        <Button layoutX="250" layoutY="220" onAction="#handleUpdate" prefWidth="100" text="Update" />

        <Label layoutX="70" layoutY="280" style="-fx-font-size: 16px; -fx-font-weight: bold;" text="Status:" />

        <TextArea fx:id="statusArea" editable="false" layoutX="70" layoutY="310" prefHeight="14.0" prefWidth="500" style="-fx-font-size: 14px;" wrapText="true" />
      <Button layoutX="457.0" layoutY="352.0" mnemonicParsing="false" onAction="#backButtonOnAction" prefHeight="26.0" prefWidth="80.0" text="Back" />

    </children>

</AnchorPane>
