<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.cse213_finalproject_groupno77_texttilefactory.InventoryManager.searchMaterialbyNameController">

    <children>

        <Label layoutX="180" layoutY="20" style="-fx-font-size: 22px; -fx-font-weight: bold;" text="Search Material by Name" />

        <Label layoutX="60" layoutY="100" style="-fx-font-size: 16px;" text="Enter Material Name:" />

        <TextField fx:id="searchField" layoutX="220" layoutY="95" prefWidth="250" />

        <Button layoutX="250" layoutY="150" onAction="#handleSearch" prefWidth="100" text="Search" />

        <Label layoutX="60" layoutY="220" style="-fx-font-size: 16px; -fx-font-weight: bold;" text="Result:" />

        <TextArea fx:id="resultArea" editable="false" layoutX="60" layoutY="250" prefHeight="46.0" prefWidth="500" style="-fx-font-size: 14px;" wrapText="true" />
      <Button layoutX="499.0" layoutY="337.0" mnemonicParsing="false" onAction="#backButtonOnAction" prefHeight="26.0" prefWidth="80.0" text="Back" />

    </children>

</AnchorPane>
