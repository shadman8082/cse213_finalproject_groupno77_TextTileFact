<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="450.0" prefWidth="700.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.cse213_finalproject_groupno77_texttilefactory.InventoryManager.showLowStockItemsController">

    <children>

        <VBox layoutX="20" layoutY="20" prefWidth="700" spacing="20">
            <children>

                <Label style="-fx-font-size: 20px; -fx-font-weight: bold;" text="Low Stock Items" />

                <Button fx:id="btnShowLowStock" maxWidth="200" style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-size: 14px;" text="Show Low Stock Items" />

                <TableView fx:id="lowStockTable" prefHeight="174.0" prefWidth="660.0">
                    <columns>
                        <TableColumn fx:id="colName" prefWidth="250" text="Material Name" />
                        <TableColumn fx:id="colQty" prefWidth="150" text="Quantity" />
                        <TableColumn fx:id="colThreshold" prefWidth="150" text="Threshold" />
                    </columns>
                </TableView>

            </children>
            <padding>
                <Insets bottom="20" left="20" right="20" top="20" />
            </padding>
        </VBox>
      <Button layoutX="589.0" layoutY="334.0" mnemonicParsing="false" onAction="#backButtonOnAction" prefHeight="26.0" prefWidth="80.0" text="Back" />

    </children>

</AnchorPane>
