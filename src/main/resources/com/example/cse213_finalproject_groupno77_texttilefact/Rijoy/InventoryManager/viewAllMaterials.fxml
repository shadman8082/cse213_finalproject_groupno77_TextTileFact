<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="400.0" prefWidth="650.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.cse213_finalproject_groupno77_texttilefactory.InventoryManager.viewAllMaterialsController">

    <children>

        <Label layoutX="230" layoutY="20" style="-fx-font-size: 22px; -fx-font-weight: bold;" text="View All Materials" />

        <TableView fx:id="materialsTable" layoutX="25" layoutY="70" prefHeight="182.0" prefWidth="600">

            <columns>

                <TableColumn fx:id="colName" prefWidth="200" text="Material Name" />

                <TableColumn fx:id="colQty" prefWidth="150" text="Quantity" />

                <TableColumn fx:id="colPrice" prefWidth="200" text="Price" />

            </columns>

        </TableView>

        <Button layoutX="270" layoutY="360" onAction="#handleRefresh" prefWidth="100" text="Refresh" />
      <Button layoutX="499.0" layoutY="337.0" mnemonicParsing="false" onAction="#backButtonOnAction" prefHeight="26.0" prefWidth="80.0" text="Back" />

    </children>

</AnchorPane>
