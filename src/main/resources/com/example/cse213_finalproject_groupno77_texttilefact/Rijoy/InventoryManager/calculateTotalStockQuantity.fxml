<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.cse213_finalproject_groupno77_texttilefactory.InventoryManager.calculateTotalStockQuantityController">

    <children>

        <Label layoutX="190" layoutY="20" style="-fx-font-size: 22px; -fx-font-weight: bold;" text="Total Stock Quantity" />

        <Button layoutX="250" layoutY="120" onAction="#handleCalculate" prefWidth="120" text="Calculate" />

        <Label layoutX="70" layoutY="220" style="-fx-font-size: 16px; -fx-font-weight: bold;" text="Total Quantity:" />

        <TextArea fx:id="resultArea" editable="false" layoutX="70" layoutY="250" prefHeight="90" prefWidth="500" style="-fx-font-size: 15px;" wrapText="true" />
      <Button layoutX="490.0" layoutY="359.0" mnemonicParsing="false" onAction="#backButtonOnAction" prefHeight="26.0" prefWidth="80.0" text="Back" />

    </children>

</AnchorPane>
