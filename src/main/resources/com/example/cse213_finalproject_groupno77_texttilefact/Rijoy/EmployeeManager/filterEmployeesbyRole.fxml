<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>

<AnchorPane prefHeight="400.0" prefWidth="600.0"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.cse213_finalproject_groupno77_texttilefactory.EmployeeManager.filterEmployeesByRoleController">

    <children>

        <Label text="Filter Employees by Role" layoutX="200" layoutY="20"/>

        <Label text="Role:" layoutX="50" layoutY="70"/>
        <TextField fx:id="roleField" layoutX="100" layoutY="65" prefWidth="200"/>

        <Button text="Filter" layoutX="320" layoutY="65" onAction="#handleFilter"/>

        <TableView fx:id="tblFiltered" layoutX="50" layoutY="120" prefWidth="500" prefHeight="200">
            <columns>
                <TableColumn fx:id="colID" text="Employee ID" prefWidth="150"/>
                <TableColumn fx:id="colName" text="Name" prefWidth="200"/>
                <TableColumn fx:id="colRole" text="Role" prefWidth="150"/>
            </columns>
        </TableView>

        <Button text="Back" layoutX="500" layoutY="340" onAction="#backButtonOnAction"/>

    </children>

</AnchorPane>
