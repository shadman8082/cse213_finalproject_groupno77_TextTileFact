<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="400.0" prefWidth="600.0"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.cse213_finalproject_groupno77_texttilefactory.EmployeeManager.viewAllEmployeesController">

    <children>
        <Label text="All Employees" layoutX="250" layoutY="20" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

        <TableView fx:id="employeeTable" layoutX="50" layoutY="60" prefWidth="500" prefHeight="250">
            <columns>
                <TableColumn fx:id="colID" text="Employee ID" prefWidth="150"/>
                <TableColumn fx:id="colName" text="Name" prefWidth="200"/>
                <TableColumn fx:id="colRole" text="Role" prefWidth="150"/>
            </columns>
        </TableView>

        <Button text="Back" layoutX="500" layoutY="340" onAction="#backButtonOnAction"/>
    </children>
</AnchorPane>
