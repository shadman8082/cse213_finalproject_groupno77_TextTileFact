<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="400.0" prefWidth="600.0"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.cse213_finalproject_groupno77_texttilefactory.EmployeeManager.searchEmployeebyIDController">

    <children>
        <Label text="Search Employee by ID" layoutX="200" layoutY="20" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

        <Label text="Employee ID:" layoutX="50" layoutY="70"/>
        <TextField fx:id="idField" layoutX="150" layoutY="65" prefWidth="200"/>

        <Button text="Search" layoutX="370" layoutY="65" onAction="#handleSearch"/>
        <Button text="Back" layoutX="500" layoutY="340" onAction="#backButtonOnAction"/>

        <TextArea fx:id="resultArea" layoutX="50" layoutY="120" prefWidth="500" prefHeight="200"/>
    </children>
</AnchorPane>
