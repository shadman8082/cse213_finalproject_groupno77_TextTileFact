<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="15" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.cse213_finalproject_groupno77_texttilefact.Shadman.StaffPerformanceController">

    <Label style="-fx-font-size: 18;" text="Staff Performance" />
    <Separator />

    <TableView fx:id="staffTable" prefHeight="300">
        <columns>
            <TableColumn fx:id="colStaffName" prefWidth="150" text="Name" />
            <TableColumn fx:id="colStaffRole" prefWidth="120" text="Role" />
            <TableColumn fx:id="colStaffCompleted" prefWidth="100" text="Completed" />
            <TableColumn fx:id="colStaffRating" prefWidth="100" text="Rating" />
        </columns>
    </TableView>

    <HBox spacing="20">
        <VBox prefWidth="300" spacing="10">
            <Label text="Update Rating" />
            <ComboBox fx:id="comboStaff" promptText="Select Staff" />
         <CheckBox fx:id="CheackBoxBad" mnemonicParsing="false" text="BAD" />
         <CheckBox fx:id="CheckBoxGood" mnemonicParsing="false" text="GOOD" />
         <CheckBox fx:id="CheackBoxBest" mnemonicParsing="false" text="Best" />
            <Label fx:id="lblRatingValue" text="Rating: 3" />
            <Label fx:id="lblUpdateStatus" text="" />
            <Button fx:id="btnUpdateRating" onAction="#handleUpdateRating" text="Update Rating" />
        </VBox>

        <VBox spacing="10">
            <Label text="Performance Summary" />
            <TextArea fx:id="txtSummary" editable="false" prefHeight="150" prefWidth="300" />
            <Button fx:id="btnGenerateSummary" onAction="#handleGenerateSummary" text="Generate Summary" />
        </VBox>
    </HBox>

</VBox>
